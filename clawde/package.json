{
  "name": "clawde",
  "version": "0.1.0",
  "description": "🦞 Clawde — your private, local-first lobster AI assistant. Chat with it from WhatsApp, Discord, Telegram and Slack, by text or by voice.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "clawde": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --import tsx src/cli.ts",
    "start": "node dist/cli.js start",
    "setup": "node dist/cli.js setup",
    "doctor": "node dist/cli.js doctor",
    "chat": "node dist/cli.js chat",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "optionalDependencies": {
    "@slack/bolt": "^4.2.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "discord.js": "^14.16.3",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "ai",
    "assistant",
    "local",
    "ollama",
    "privacy",
    "chatbot",
    "whatsapp",
    "discord",
    "telegram",
    "slack",
    "voice",
    "lobster"
  ]
}
