# Clawde reads secrets from ~/.clawde/config.json (written by `clawde setup`).
# If you'd rather keep secrets out of that file, set them here instead —
# environment variables always override the config file.
#
# Copy to `.env` and fill in only what you need.

# Local model (Ollama)
# OLLAMA_HOST=http://127.0.0.1:11434
# CLAWDE_MODEL=llama3.1

# Where Clawde stores config + session state (defaults to ~/.clawde)
# CLAWDE_HOME=./.clawde

# Chat app credentials (optional — the setup wizard can store these for you)
# TELEGRAM_TOKEN=123456:ABC-your-botfather-token
# DISCORD_TOKEN=your-discord-bot-token
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
